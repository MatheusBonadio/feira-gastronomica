APP_NAME="Feira Gastronômica UNAERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=feira_gastronomica
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=60
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

FEIRA_LOGIN_MAX_TENTATIVAS=5
FEIRA_LOGIN_BLOQUEIO_MINUTOS=15
FEIRA_POR_PAGINA=20
FEIRA_SENHA_DEMO=feira2027

INERTIA_ENCRYPT_HISTORY=false
INERTIA_SSR_ENABLED=false

VITE_APP_NAME="${APP_NAME}"
